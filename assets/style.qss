/* Ce est au format QSS (Qt Style Sheets) */

/* Arrière plans */
#root {
    background: #2e0259;
}

#card {
    background-color: #090113;
    border-radius: 20px;
}

/* Textes */
QLabel {
    color: white;
    font-size: 13px;
    background: transparent;
}

#title {
    color: white;
    font-size: 28px;
    font-weight: 700;
}

#subtitle {
    color: #b2abb3;
    font-size: 13px;
}

#fieldLabel {
    color: #b2abb3;
    font-size: 12px;
    font-weight: 600;
}

/* Entrées */
QLineEdit {
    background-color: #470b88;
    border: 2px solid #cbacf6;
    border-radius: 10px;
    padding: 10px 12px;
    color: white;
    font-size: 14px;
    selection-background-color: #b294e2;
}

QLineEdit:hover {
    border-color: #cab6e7;
}

QLineEdit:focus {
    border-color: #d9cbec;
}

/* Dropdowns */
QComboBox {
    background-color: #470b88;
    border: 2px solid #cbacf6;
    border-radius: 10px;
    padding: 10px 12px;
    color: white;
    font-size: 14px;
    combobox-popup: 0;
}

QComboBox:hover {
    border-color: #cab6e7;
}

QComboBox:focus,
QComboBox:on {
    border-color: #d9cbec;
}

QComboBox QAbstractItemView {
    background-color: #470b88;
    color: white;
    border: 1px solid #cbacf6;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 0 12px;
    border-radius: 6px;
    color: white;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #374151;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #6366f1;
    color: white;
}

/* Checkboxes */
QCheckBox {
    color: #9ca3af;
    font-size: 12px;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 2px solid #cbacf6;
    background: #1f2937;
}

QCheckBox::indicator:checked {
    background: #6366f1;
    border-color: #d9cbec;
}

/* Boutons */
#primaryButton {
    background: #b294e2;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    font-weight: 700;
}

#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #818cf8, stop:1 #a78bfa);
}

#primaryButton:pressed {
    background: #4f46e5;
}

#linkButton {
    background: transparent;
    border: none;
    color: #818cf8;
    font-size: 13px;
    font-weight: 600;
}

#linkButton:hover {
    color: #a5b4fc;
    text-decoration: underline;
}

#messageLabel {
    color: #fca5a5;
    background-color: rgba(239, 68, 68, 30);
    border: 1px solid rgba(239, 68, 68, 90);
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12px;
}