QTableView {
    background-color: #2a003d;
    color: #fafafa;
    alternate-background-color: #f0f3f7;
    gridline-color: #cccccc;
    font-family: Arial;
    font-size: 14px;
    selection-background-color: #82689b;
    selection-color: white;
}

QHeaderView::section {
    background-color: #2a003d;
    color: #fafafa;
    padding: 8px;
    border: 1px solid #2a003d;
    font-weight: bold;
}